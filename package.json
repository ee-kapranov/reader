{
  "name": "reader",
  "version": "1.0.0",
  "description": "Text-to-speech reader web app",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "nodemon --ext ts --exec 'tsx src/server.ts'",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ee-kapranov/reader.git"
  },
