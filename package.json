  },
  "homepage": "https://github.com/ee-kapranov/reader#readme",
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "esbuild": "^0.27.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
